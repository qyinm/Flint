# Copy to .env.release.local for a local public macOS release.
# Never commit the real .env.release.local file.

FLINT_VERSION=0.1.0
FLINT_NOTARIZE=1

# Must match one valid local Keychain identity from:
# security find-identity -v -p codesigning
FLINT_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Apple notarization credentials.
# Use an app-specific password, not your Apple ID account password.
APPLE_ID="you@example.com"
APPLE_TEAM_ID="TEAMID"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
